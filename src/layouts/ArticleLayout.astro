---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { content } from '../data/content';
import { formatDate, withBase } from '../data/site';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
---

<BaseLayout
  title={`${article.data.title} — Dimitrii Codrean`}
  description={article.data.description}
>
  <article class="article-page">
    <header class="article-header">
      <a class="back-link" href={withBase('/articles/')}>{content.writing.backLink}</a>
      <p class="eyebrow">{formatDate(article.data.publishedAt)}</p>
      <h1>{article.data.title}</h1>
      <p class="dek">{article.data.description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
