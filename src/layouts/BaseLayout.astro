---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../data/content';
import { site, withBase } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  dark?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image = withBase('/og.jpg'),
  dark = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class:list={{ dark }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={dark ? '#11110f' : '#efede7'} />
    <script is:inline>
      try {
        const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', isDark ? '#11110f' : '#efede7');
      } catch {
        // Use the page's default theme when browser preferences are unavailable.
      }
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{content.accessibility.skipToContent}</a>
    <div class="page-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
