---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import { content } from '../data/content';
import { galleries } from '../data/galleries';
import { withBase } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <div class="hero-frame">
    <a
      class="hero-link"
      href={withBase('/photography/')}
      aria-label={content.home.heroLinkLabel}
    >
      <Picture
        src={galleries[0].cover}
        alt={content.home.heroAlt}
        widths={[720, 1080, 1600, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        quality={88}
      />
    </a>
    <p class="hero-caption">{content.home.heroCaption}</p>
  </div>

  <section class="writing-preview home-writing-preview" aria-labelledby="latest-writing">
    <div class="section-heading">
      <h2 id="latest-writing">{content.home.latestWritingHeading}</h2>
      <a href={withBase('/articles/')}>{content.home.allArticlesLink}</a>
    </div>
    {articles.length > 0 ? (
      articles.map((article) => <ArticleCard {article} />)
    ) : (
      <div class="empty-state">
        <p>{content.home.emptyWriting}</p>
      </div>
    )}
  </section>
</BaseLayout>
