---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title={content.writing.pageTitle}
  description={content.writing.pageDescription}
>
  <section class="writing-preview" aria-label="Articles">
    <div class="section-heading page-section-heading">
      <h2>{content.writing.allWritingHeading}</h2>
      <p>{articles.length === 1 ? '1 published article' : `${articles.length} published articles`}</p>
    </div>
    {articles.length > 0 ? (
      articles.map((article) => <ArticleCard {article} />)
    ) : (
      <div class="empty-state">
        <p>{content.writing.emptyState}</p>
      </div>
    )}
  </section>
</BaseLayout>
