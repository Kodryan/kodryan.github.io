---
import type { CollectionEntry } from 'astro:content';
import { content } from '../data/content';
import { formatDate, withBase } from '../data/site';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
---

<article class="article-card">
  <p class="article-date">{formatDate(article.data.publishedAt)}</p>
  <div>
    <h2><a href={withBase(`/articles/${article.id}/`)}>{article.data.title}</a></h2>
    <p>{article.data.description}</p>
  </div>
  <a class="read-link" href={withBase(`/articles/${article.id}/`)} aria-label={`Read ${article.data.title}`}>
    {content.writing.readLink} <span aria-hidden="true">↗</span>
  </a>
</article>
